// Morris Management — core data model (v0.1 foundation)
// The spine: every record belongs to exactly one Agency (the tenant boundary).
// Isolation is enforced in application queries by always scoping to agencyId.
//
// Prisma 7: the datasource `url` lives in prisma.config.ts, not here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// The tenant boundary. Every other record hangs off exactly one Agency.
model Agency {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agents     Agent[]
  people     Person[]
  properties Property[]
  bookings   Booking[]

  @@map("agencies")
}

enum AgentRole {
  ADMIN
  AGENT
}

model Agent {
  id        String    @id @default(cuid())
  agencyId  String
  name         String
  email        String
  passwordHash String?  // set when the realtor has login access
  role         AgentRole @default(AGENT)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  agency     Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  properties Property[]
  bookings   Booking[]

  @@unique([agencyId, email])
  @@index([agencyId])
  @@map("agents")
}

enum LeadRole {
  BUYER
  SELLER
  RENTER
  INVESTOR
  UNKNOWN
}

enum LeadTemperature {
  HOT
  WARM
  COLD
  UNSET
}

enum VerificationState {
  NONE
  VERIFIED
  FLAGGED
}

model Person {
  id             String  @id @default(cuid())
  agencyId       String
  conversationId String? // ties an anonymous chat session to a lead record

  name             String?
  phone            String?
  email            String?
  preferredChannel String?

  role            LeadRole @default(UNKNOWN)
  propertyType    String?
  location        String?
  budget          String?
  financingStatus String?
  timeline        String?
  source          String?

  temperature         LeadTemperature   @default(UNSET)
  verificationState   VerificationState @default(NONE)
  failedVerifications Int               @default(0)
  notes               String?           // agent's private notes on this lead

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency   Agency      @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  bookings Booking[]
  events   LeadEvent[]

  @@index([agencyId])
  @@index([agencyId, phone])
  @@index([agencyId, email])
  @@index([agencyId, conversationId])
  @@map("people")
}

enum PropertyReviewStatus {
  DRAFT
  LIVE
}

model Property {
  id       String  @id @default(cuid())
  agencyId String
  agentId  String?

  title       String?
  location    String?
  price       String?
  rooms       String?
  sizeSqm     String?
  description String?

  reviewStatus PropertyReviewStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agent  Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  images PropertyImage[]

  @@index([agencyId])
  @@index([agencyId, agentId])
  @@map("properties")
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
}

/// A 15-minute intro call between a lead and an agent.
/// Calendar sync (Google/Outlook only; never Apple) plugs in at the
/// externalEventId seam without changing the rest of the model.
model Booking {
  id       String @id @default(cuid())
  agencyId String
  personId String
  agentId  String?

  startsAt DateTime
  durationMinutes Int @default(15)
  status   BookingStatus @default(REQUESTED)

  externalCalendar String? // "google" | "outlook"
  externalEventId  String? // id in the agent's calendar once synced

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  person Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  agent  Agent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([agencyId])
  @@index([agencyId, agentId])
  @@index([personId])
  @@map("bookings")
}

/// An image attached to a property (photo, floor plan). Stored inline as a data
/// URL for the pilot; swap to object storage (R2/S3) by changing only `url`.
model PropertyImage {
  id         String  @id @default(cuid())
  propertyId String
  url        String  @db.Text   // data URL or external URL
  label      String?            // e.g. "Floor plan", "Kitchen"
  kind       String  @default("photo") // "photo" | "floorplan"
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_images")
}

/// Timeline of everything that happened to a lead - captures, edits, bookings.
model LeadEvent {
  id       String   @id @default(cuid())
  agencyId String
  personId String
  type     String   // "captured" | "updated" | "booking" | "verified" | "flagged" | "note"
  detail   String?  // human-readable description
  createdAt DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, createdAt])
  @@index([agencyId])
  @@map("lead_events")
}
